# Port `npm start` binds to in production. Defaults to 3000 if unset.
PORT=3000

# Path to the SQLite database file. Keep this outside .next/build output.
DATABASE_URL=./data/app.db

# Password required to sign in to the app. Choose something strong.
APP_PASSWORD=change-me

# Random secret (32+ chars) used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app (used for absolute links, e.g. in emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API key, used to send campaign emails. https://resend.com/api-keys
RESEND_API_KEY=re_change-me

# Signing secret for the Resend inbound-email webhook, shown when you create the
# webhook endpoint (Resend dashboard -> Webhooks -> Add Endpoint, URL:
# <NEXT_PUBLIC_APP_URL>/api/webhooks/resend, subscribed to the "email.received"
# event only). Inbound receiving also requires adding an MX record for your
# sending domain in the Resend dashboard (Domains -> your domain -> Receiving) --
# that DNS change is external to this app and must be done there.
RESEND_WEBHOOK_SECRET=whsec_change-me

# API key for the Resend account that owns the RECEIVING domain, used to fetch
# inbound email content after the webhook fires. Only needed when sending and
# receiving domains live in different Resend accounts (e.g. the free plan,
# which allows one verified domain per account) -- otherwise omit this and
# RESEND_API_KEY is used for both.
RESEND_RECEIVING_API_KEY=re_change-me

# Cloudflare R2 bucket that stores inbound/outbound message attachments
# (images, files). Set up once at https://dash.cloudflare.com -> R2:
#   1. Create a bucket (e.g. "successor-crm-attachments"). Free tier: 10GB
#      storage, no egress fees -- plenty for a personal-CRM-scale inbox.
#   2. R2 -> Manage API Tokens -> Create API Token -> permissions
#      "Object Read & Write", scoped to that bucket. Copy the Access Key ID
#      and Secret Access Key it gives you (shown once).
#   3. R2_ACCOUNT_ID is the hex string in your R2 dashboard URL/API
#      endpoint (https://<account_id>.r2.cloudflarestorage.com).
# Do NOT make the bucket public -- the app reads/writes it directly and
# hands out short-lived signed URLs, so it stays private.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=change-me
