# Port `npm start` binds to in production. Defaults to 3000 if unset.
PORT=3000

# Path to the SQLite database file. Keep this outside .next/build output.
DATABASE_URL=./data/app.db

# Password required to sign in to the app. Choose something strong.
APP_PASSWORD=change-me

# Random secret (32+ chars) used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public URL of the deployed app (used for absolute links, e.g. in emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API key, used to send campaign emails. https://resend.com/api-keys
RESEND_API_KEY=re_change-me

# Signing secret for the Resend inbound-email webhook, shown when you create the
# webhook endpoint (Resend dashboard -> Webhooks -> Add Endpoint, URL:
# <NEXT_PUBLIC_APP_URL>/api/webhooks/resend, subscribed to the "email.received"
# event only). Inbound receiving also requires adding an MX record for your
# sending domain in the Resend dashboard (Domains -> your domain -> Receiving) --
# that DNS change is external to this app and must be done there.
RESEND_WEBHOOK_SECRET=whsec_change-me
